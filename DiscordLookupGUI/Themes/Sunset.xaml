<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ══════════════════════════════════════════
         テーマ: Sunset (トワイライト街並み背景イラスト ＆ 鮮烈なサンセットオレンジ)
         ══════════════════════════════════════════ -->
    <Color x:Key="WindowBgColor">#FF1A0B2E</Color>
    <Color x:Key="HeaderBgColor">#E6180A28</Color>
    <Color x:Key="CardBgColor">#D9230E2E</Color>
    <Color x:Key="CardInnerBgColor">#80140722</Color>
    <Color x:Key="CardBorderColor">#66F97316</Color>

    <!-- メインアクセントカラー (燃えるような夕日オレンジ ＆ 宵の明星ゴールド/パープル) -->
    <Color x:Key="AccentColor">#FFF97316</Color>
    <Color x:Key="AccentCyan">#FFF97316</Color>
    <Color x:Key="AccentBlue">#FFF59E0B</Color>
    <Color x:Key="AccentPurple">#FFC084FC</Color>

    <!-- テキストカラー (夕焼けの光と抜群の視認性: UTCやEpochもくっきり) -->
    <Color x:Key="TextPrimary">#FFFFFAF5</Color>
    <Color x:Key="TextSecondary">#FFFDE68A</Color>
    <Color x:Key="TextMuted">#FFE9D5FF</Color>
    <Color x:Key="DangerRed">#FFF43F5E</Color>
    <Color x:Key="SuccessGreen">#FF10B981</Color>

    <!-- 背景画像 & すりガラスオーバーレイ (トワイライト街並み + 半透明ティント) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF140722" />
    <BitmapImage x:Key="ThemeBackgroundImage" UriSource="pack://application:,,,/DiscordLookupGUI;component/Assets/sunset_bg.jpg" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#66140724" />

    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="{StaticResource CardInnerBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <!-- コントロール固有背景 ＆ オレンジが美しく映える配色 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#80140722" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#66F97316" />
    <SolidColorBrush x:Key="TabContainerBgBrush" Color="#CC140726" />
    <SolidColorBrush x:Key="TabBorderBrush" Color="#80F97316" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#FFF7EDF9" />
    <SolidColorBrush x:Key="SearchContainerBgBrush" Color="#502D0F38" />
    <SolidColorBrush x:Key="SearchContainerBorderBrush" Color="#80F97316" />
    <SolidColorBrush x:Key="BannerBgBrush" Color="#250F28" />
    <SolidColorBrush x:Key="FooterBgBrush" Color="#66140724" />
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#4DF97316" />
    <SolidColorBrush x:Key="AccentGlowLowBrush" Color="#26F97316" />
    <SolidColorBrush x:Key="AccentGlowMidBrush" Color="#4DF97316" />
    <SolidColorBrush x:Key="AccentGlowHighBrush" Color="#80F97316" />
    <Color x:Key="SearchIconGlowColor">#FFF97316</Color>
    <SolidColorBrush x:Key="SearchIconBrush" Color="#FFF97316" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FFD4B5DD" />
    <Visibility x:Key="StarryDecorationVisibility">Collapsed</Visibility>
    <Visibility x:Key="GamingRgbVisibility">Collapsed</Visibility>

    <!-- コントロール用 Freeze 済みグローエフェクト (テーマ動的追従・継承コンテキスト競合なし) -->
    <DropShadowEffect x:Key="PillTabGlowEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="GlowButtonHoverEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="CyberTextBoxFocusEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />

</ResourceDictionary>
