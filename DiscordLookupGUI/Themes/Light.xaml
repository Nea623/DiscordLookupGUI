<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════
         テーマ: Light (洗練されたフロストホワイト ＆ エレクトリックティール)
         ══════════════════════════════════════════ -->
    <Color x:Key="WindowBgColor">#FFF0F4F8</Color>
    <Color x:Key="HeaderBgColor">#E6FFFFFF</Color>
    <Color x:Key="CardBgColor">#FFFFFFFF</Color>
    <Color x:Key="CardInnerBgColor">#FFF8FAFC</Color>
    <Color x:Key="CardBorderColor">#FFE2E8F0</Color>

    <!-- メインアクセントカラー (明るいエレクトリックティール/シアン) -->
    <Color x:Key="AccentColor">#FF0D9488</Color>
    <Color x:Key="AccentCyan">#FF0D9488</Color>
    <Color x:Key="AccentBlue">#FF2563EB</Color>
    <Color x:Key="AccentPurple">#FF7C3AED</Color>

    <!-- テキストカラー (濃紺スレートで抜群の視認性) -->
    <Color x:Key="TextPrimary">#FF0F172A</Color>
    <Color x:Key="TextSecondary">#FF475569</Color>
    <Color x:Key="TextMuted">#FF94A3B8</Color>
    <Color x:Key="DangerRed">#FFE11D48</Color>
    <Color x:Key="SuccessGreen">#FF059669</Color>

    <!-- ブラシ定義 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="{StaticResource CardInnerBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <!-- コントロール固有背景 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="TabContainerBgBrush" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="BannerBgBrush" Color="#FFE2E8F0" />

</ResourceDictionary>
