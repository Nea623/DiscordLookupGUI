<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ══════════════════════════════════════════
         テーマ: Starry Night (🌠 満天の星降る夜 ＆ 動く星空GIFすりガラス)
         満天のバイオレット銀河アニメーションGIFと、透明感あふれる深紫クリスタルガラス
         ══════════════════════════════════════════ -->
    <Color x:Key="WindowBgColor">#FF0D071E</Color>
    <Color x:Key="HeaderBgColor">#73100726</Color>
    <Color x:Key="CardBgColor">#6614082C</Color>
    <Color x:Key="CardInnerBgColor">#730A0418</Color>
    <Color x:Key="CardBorderColor">#B3FFFFFF</Color>

    <!-- メインアクセントカラー (ネブラバイオレット ＆ スターダストラベンダー) -->
    <Color x:Key="AccentColor">#FFA855F7</Color>
    <Color x:Key="AccentCyan">#FFC084FC</Color>
    <Color x:Key="AccentBlue">#FF818CF8</Color>
    <Color x:Key="AccentPurple">#FFE879F9</Color>

    <!-- テキストカラー (クリアフロストハイコントラスト) -->
    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FFF3E8FF</Color>
    <Color x:Key="TextMuted">#FFC4B5FD</Color>
    <Color x:Key="DangerRed">#FFF43F5E</Color>
    <Color x:Key="SuccessGreen">#FF34D399</Color>

    <!-- 背景ブラシ (下地深海パープル) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF0D071E" />
    <x:Null x:Key="ThemeBackgroundImage" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#00000000" />

    <!-- すりガラス板 (透き通る深紫ガラスレイヤーで星空の瞬きをダイレクトに満喫) -->
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="{StaticResource CardInnerBgColor}" />

    <!-- ガラスエッジ: 上部から光が当たるクリスタル反射グラデーション境界線 -->
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3FFFFFF" Offset="0.0" />
        <GradientStop Color="#66C084FC" Offset="0.5" />
        <GradientStop Color="#40FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <!-- コントロール固有背景 ＆ クリスタルガラスレイヤー配色 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#590A0418" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#66C084FC" />
    <SolidColorBrush x:Key="TabContainerBgBrush" Color="#590D0524" />
    <SolidColorBrush x:Key="TabBorderBrush" Color="#66C084FC" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#FFF3E8FF" />
    <SolidColorBrush x:Key="SearchContainerBgBrush" Color="#5914082C" />
    <SolidColorBrush x:Key="SearchContainerBorderBrush" Color="#80C084FC" />
    <SolidColorBrush x:Key="BannerBgBrush" Color="#4D100832" />
    <SolidColorBrush x:Key="FooterBgBrush" Color="#4D0D071E" />
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#66A855F7" />
    <SolidColorBrush x:Key="AccentGlowLowBrush" Color="#26A855F7" />
    <SolidColorBrush x:Key="AccentGlowMidBrush" Color="#4DA855F7" />
    <SolidColorBrush x:Key="AccentGlowHighBrush" Color="#80A855F7" />
    <Color x:Key="SearchIconGlowColor">#FFC084FC</Color>
    <SolidColorBrush x:Key="SearchIconBrush" Color="#FFC084FC" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FFD8B4FE" />
    <Visibility x:Key="LunarDecorationVisibility">Collapsed</Visibility>
    <Visibility x:Key="GamingRgbVisibility">Collapsed</Visibility>
    <Visibility x:Key="StarryNightAnimationVisibility">Visible</Visibility>

    <!-- コントロール用 Freeze 済みグローエフェクト (コズミックネブラグロー) -->
    <DropShadowEffect x:Key="PillTabGlowEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.65" />
    <DropShadowEffect x:Key="GlowButtonHoverEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
    <DropShadowEffect x:Key="CyberTextBoxFocusEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.65" />

</ResourceDictionary>
