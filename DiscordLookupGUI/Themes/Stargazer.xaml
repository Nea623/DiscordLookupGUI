<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ══════════════════════════════════════════
         テーマ: Stargazer (🌌 星空を見つめる二人 ＆ コズミックラベンダーパープル)
         満天のバイオレット銀河・天の川と、きらめく星屑のパープルグラデーション
         ══════════════════════════════════════════ -->
    <Color x:Key="WindowBgColor">#FF100826</Color>
    <Color x:Key="HeaderBgColor">#E61A0C38</Color>
    <Color x:Key="CardBgColor">#D91E103E</Color>
    <Color x:Key="CardInnerBgColor">#8012082E</Color>
    <Color x:Key="CardBorderColor">#66A855F7</Color>

    <!-- メインアクセントカラー (ネブラバイオレット ＆ スターダストラベンダー) -->
    <Color x:Key="AccentColor">#FFA855F7</Color>
    <Color x:Key="AccentCyan">#FFC084FC</Color>
    <Color x:Key="AccentBlue">#FF818CF8</Color>
    <Color x:Key="AccentPurple">#FFE879F9</Color>

    <!-- テキストカラー (星光のクリアハイコントラスト) -->
    <Color x:Key="TextPrimary">#FFFFF7FF</Color>
    <Color x:Key="TextSecondary">#FFE9D5FF</Color>
    <Color x:Key="TextMuted">#FFA78BFA</Color>
    <Color x:Key="DangerRed">#FFF43F5E</Color>
    <Color x:Key="SuccessGreen">#FF34D399</Color>

    <!-- 背景画像 & すりガラスオーバーレイ (天の川を見上げる二人 + コズミック半透明ティント) -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF100826" />
    <BitmapImage x:Key="ThemeBackgroundImage" UriSource="pack://application:,,,/DiscordLookupGUI;component/Assets/stargazer_bg.jpg" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#4D120836" />

    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="{StaticResource CardInnerBgColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <!-- コントロール固有背景 ＆ コズミックパープル配色 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#80140830" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#66A855F7" />
    <SolidColorBrush x:Key="TabContainerBgBrush" Color="#CC140832" />
    <SolidColorBrush x:Key="TabBorderBrush" Color="#80A855F7" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#FFF3E8FF" />
    <SolidColorBrush x:Key="SearchContainerBgBrush" Color="#50281248" />
    <SolidColorBrush x:Key="SearchContainerBorderBrush" Color="#80A855F7" />
    <SolidColorBrush x:Key="BannerBgBrush" Color="#1E0C34" />
    <SolidColorBrush x:Key="FooterBgBrush" Color="#66100826" />
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#4DA855F7" />
    <SolidColorBrush x:Key="AccentGlowLowBrush" Color="#26A855F7" />
    <SolidColorBrush x:Key="AccentGlowMidBrush" Color="#4DA855F7" />
    <SolidColorBrush x:Key="AccentGlowHighBrush" Color="#80A855F7" />
    <Color x:Key="SearchIconGlowColor">#FFC084FC</Color>
    <SolidColorBrush x:Key="SearchIconBrush" Color="#FFC084FC" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FFC4B5FD" />
    <Visibility x:Key="StarryDecorationVisibility">Collapsed</Visibility>
    <Visibility x:Key="GamingRgbVisibility">Collapsed</Visibility>

    <!-- コントロール用 Freeze 済みグローエフェクト (コズミックネブラグロー) -->
    <DropShadowEffect x:Key="PillTabGlowEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="GlowButtonHoverEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
    <DropShadowEffect x:Key="CyberTextBoxFocusEffect" po:Freeze="True" Color="{StaticResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />

</ResourceDictionary>
