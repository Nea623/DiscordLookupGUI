<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════
         テーマ: Gaming RGB (完全漆黒の純黒背景 ＆ ゲーミングネオングリーン ＆ 無限RGBサイクル)
         ══════════════════════════════════════════ -->
    <Color x:Key="WindowBgColor">#FF000000</Color>
    <Color x:Key="HeaderBgColor">#FF000000</Color>
    <Color x:Key="CardBgColor">#FF080808</Color>
    <Color x:Key="CardInnerBgColor">#FF030303</Color>
    <Color x:Key="CardBorderColor">#FF181818</Color>

    <!-- メインアクセントカラー (鮮烈なゲーミングネオングリーン) -->
    <Color x:Key="AccentColor">#FF00FF66</Color>
    <Color x:Key="AccentCyan">#FF00FF66</Color>
    <Color x:Key="AccentBlue">#FF00E676</Color>
    <Color x:Key="AccentPurple">#FF00FF88</Color>

    <!-- テキストカラー (純黒背景に映えるピュアホワイト) -->
    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FFB0B0B0</Color>
    <Color x:Key="TextMuted">#FF666666</Color>
    <Color x:Key="DangerRed">#FFFF3366</Color>
    <Color x:Key="SuccessGreen">#FF00FF66</Color>

    <!-- 完全漆黒の純黒背景ブラシ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF080808" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="#FF030303" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF181818" />

    <!-- ゲーミングネオングリーンブラシ (ボタン・タブ・雷マーク・選択要素) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF00FF66" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF00FF66" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF00E676" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#FF00FF88" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <!-- コントロール固有背景 ＆ ゲーミングネオングリーン配色 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#FF030303" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="TabContainerBgBrush" Color="#FF040404" />
    <SolidColorBrush x:Key="TabBorderBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TabTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SearchContainerBgBrush" Color="#FF050505" />
    <SolidColorBrush x:Key="SearchContainerBorderBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BannerBgBrush" Color="#FF080808" />
    <SolidColorBrush x:Key="FooterBgBrush" Color="#00000000" />
    <SolidColorBrush x:Key="FooterBorderBrush" Color="#FF141414" />
    <SolidColorBrush x:Key="AccentGlowLowBrush" Color="#FF263028" />
    <SolidColorBrush x:Key="AccentGlowMidBrush" Color="#3000FF66" />
    <SolidColorBrush x:Key="AccentGlowHighBrush" Color="#6000FF66" />

    <!-- 星空装飾は非表示、Gaming RGB エフェクトを表示 -->
    <Visibility x:Key="StarryDecorationVisibility">Collapsed</Visibility>
    <Visibility x:Key="GamingRgbVisibility">Visible</Visibility>

    <!-- 背景画像 & すりガラスオーバーレイ (GamingRGBは完全漆黒) -->
    <x:Null x:Key="ThemeBackgroundImage" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#00000000" />

</ResourceDictionary>