<Window x:Class="DiscordLookup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="Discord Lookup" 
        Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI, Segoe UI Emoji, Yu Gothic UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- 外枠とシャドウ -->
    <Border Margin="12" CornerRadius="18" BorderThickness="1" BorderBrush="#354A6B">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF080C14" Offset="0.0" />
                <GradientStop Color="#FF0E1726" Offset="0.5" />
                <GradientStop Color="#FF070B12" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" /> <!-- タイトルバー -->
                <RowDefinition Height="Auto" /> <!-- 検索 & トークン設定バー -->
                <RowDefinition Height="*" /> <!-- メインコンテンツエリア -->
                <RowDefinition Height="36" /> <!-- ステータスフッター -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 1. タイトルバー (ドラッグ移動可能)
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="18,18,0,0">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側: ブランドロゴ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#204DF2D3" BorderBrush="#804DF2D3" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
                        </Border>
                        <TextBlock Text="DISCORD" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" LOOKUP" FontWeight="Light" FontSize="16" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" VerticalAlignment="Center" Background="#1A3B82F6" CornerRadius="8" Padding="7,2">
                            <TextBlock Text="v2.0" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 中央: ピルナビゲーションタブ (ウィンドウ全体の完全中央・左右均等配置) -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#80060A12" CornerRadius="18" Padding="4" BorderThickness="1" BorderBrush="#203A6B9B">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Main" IsChecked="True" x:Name="TabMain" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Raw Data" x:Name="TabRaw" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Settings" x:Name="TabSettings" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                        </UniformGrid>
                    </Border>

                    <!-- 右側: ウィンドウ操作ボタン -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCircleButton}" Content="─" Click="MinimizeButton_Click" Margin="0,0,8,0" ToolTip="最小化" />
                        <Button Style="{StaticResource WindowCloseCircleButton}" Content="✕" Click="CloseButton_Click" ToolTip="閉じる" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 2. 検索バー & クイックアクション
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="20,4,20,12" Background="#400A101C" CornerRadius="12" Padding="14,10" BorderThickness="1" BorderBrush="#253550">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ID入力欄 -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="UserIdInput" 
                                 Style="{StaticResource CyberTextBox}" 
                                 Text=""
                                 FontSize="15"
                                 KeyDown="UserIdInput_KeyDown"
                                 VerticalContentAlignment="Center"
                                 Padding="36,8,12,8" />
                        <TextBlock Text="🔍" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="UserIdPlaceholder" Text="Discord ユーザーID (Snowflake) を入力して Enter..." 
                                   Foreground="#556987" FontSize="13" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- 検索ボタン -->
                    <Button Grid.Column="1" x:Name="SearchButton" Style="{StaticResource GlowButton}" Content="LOOKUP USER" Click="SearchButton_Click" MinWidth="130" />
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 3. メインビュー (タブ切り替え)
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="20,0,20,10">
                
                <!-- 【タブ1: MAIN 画面 (プロフィール & 分析)】 -->
                <Grid x:Name="ViewMain" Visibility="Visible">

                    <!-- 未検索時のウェルカム・案内画面 (初期表示) -->
                    <Border x:Name="EmptyStateView" Visibility="Visible" Background="{StaticResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- アイコン発光サークル -->
                            <Border Width="72" Height="72" CornerRadius="36" Background="#154DF2D3" BorderBrush="#504DF2D3" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4DF2D3" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                                <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="AWAITING USER LOOKUP" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="上部の入力欄に Discord ユーザーID (Snowflake) を入力し、Enterキーを押してください。" 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

                            <Border Background="{StaticResource CardInnerBgBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#203A6B9B">
                                <TextBlock Text="💡 ヒント: Discordでユーザーを右クリック ➔ 「ユーザーIDをコピー」で取得できます" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 検索結果表示グリッド (初期状態は非表示) -->
                    <Grid x:Name="SearchResultGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── 左カード: User Profile ── -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Background="{StaticResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- カードヘッダー -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,10">
                                    <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="User Profile" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <!-- プロフィール詳細 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,16">
                                    
                                    <!-- バナー & アバターのコンテナ -->
                                    <Grid Margin="0,0,0,16">
                                        <!-- バナー画像 (枠全体を満たし、完全中央配置 + 角丸クリップ) -->
                                        <Border x:Name="BannerContainer" Height="130" CornerRadius="12" Background="#161F2E" BorderThickness="1" BorderBrush="#253550" SizeChanged="BannerContainer_SizeChanged">
                                            <Grid>
                                                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- アバター画像 (真円クリップ + 発光シアン外枠で絶対にはみ出さない設計) -->
                                        <Grid Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,-26">
                                            <Ellipse Width="80" Height="80" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="3" Fill="#0C1420">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#4DF2D3" BlurRadius="14" ShadowDepth="0" Opacity="0.65" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Image x:Name="AvatarImage" Width="74" Height="74" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="37,37" RadiusX="37" RadiusY="37" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Grid>

                                    <!-- ユーザー名など (Emoji.Wpf によるフルカラー絵文字描画) -->
                                    <StackPanel Margin="0,30,0,12">
                                        <emoji:TextBlock x:Name="TxtGlobalName" Text="ユーザー未検索" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <emoji:TextBlock x:Name="TxtUsername" Text="@username" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                            <Border x:Name="BadgeClan" Margin="10,0,0,0" Background="#203B82F6" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image x:Name="ImgClanBadge" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <emoji:TextBlock x:Name="TxtClanTag" Text="CLAN" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 各種情報リスト -->
                                    <Border Background="{StaticResource CardInnerBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1F2A3F">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserId" Text="-" IsReadOnly="True" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent Color" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border x:Name="RectAccentColor" Width="14" Height="14" CornerRadius="3" Background="Transparent" BorderBrush="#405575" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtAccentColor" Text="なし" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- アセットリンクボタン -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnOpenAvatar" Content="Open Avatar" Style="{StaticResource GlowButton}" FontSize="12" Padding="6,6" Click="BtnOpenAvatar_Click" IsEnabled="False" />
                                        <Button Grid.Column="2" x:Name="BtnOpenBanner" Content="Open Banner" Style="{StaticResource GlowButton}" FontSize="12" Padding="6,6" Click="BtnOpenBanner_Click" IsEnabled="False" />
                                    </Grid>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── 右カード: Timeline & Metrics ── -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- カードヘッダー -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,10">
                                <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Timeline &amp; Account Analytics" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- メトリクス詳細 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,0,16,16">

                                    <!-- メトリクス行 1: アカウント作成日 -->
                                    <Border Background="{StaticResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1F2A3F">
                                        <StackPanel>
                                            <TextBlock Text="Account Creation Date (JST)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock x:Name="TxtCreatedAtJst" Text="-- 年 -- 月 -- 日 --:--:--" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                            <TextBlock x:Name="TxtCreatedAtUtc" Text="UTC: --" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 2: 経過年数 / 経過日数 (プログレスゲージ風デザイン) -->
                                    <Border Background="{StaticResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#1F2A3F">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Account Age (経過時間)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                                <Border HorizontalAlignment="Right" Background="#204DF2D3" CornerRadius="8" Padding="8,2">
                                                    <TextBlock x:Name="TxtElapsedBadge" Text="0.0 yrs" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- バーゲージ -->
                                            <Border Height="8" CornerRadius="4" Background="#162235" Margin="0,12,0,8">
                                                <ProgressBar x:Name="ProgAccountAge" Value="0" Maximum="10" Height="8" Background="Transparent" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" />
                                            </Border>

                                            <Grid>
                                                <TextBlock Text="Day 0" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="TxtElapsedDays" Text="0 日経過" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="10+ Years" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 3: Snowflake 解析情報 -->
                                    <Border Background="{StaticResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="#1F2A3F">
                                        <StackPanel>
                                            <TextBlock Text="Snowflake Decoding" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                            
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Epoch Offset" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="1420070400000 ms" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Internal Worker ID" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtWorkerId" Text="--" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Internal Process ID" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtProcessId" Text="--" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </Grid> <!-- SearchResultGrid 終了 -->
                </Grid> <!-- ViewMain 終了 -->

                <!-- 【タブ2: RAW DATA 画面】 -->
                <Grid x:Name="ViewRaw" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Raw Discord API Response (JSON)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="1" x:Name="TxtRawJson" IsReadOnly="True" Style="{StaticResource CyberTextBox}" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="/* API レスポンスがここに表示されます */" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 【タブ3: SETTINGS 画面】 -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" Padding="20">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                            <TextBlock Text="Application Settings" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="Discord Bot Token" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6" />
                            <PasswordBox x:Name="InputBotToken" Background="{StaticResource CardInnerBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="12,10" FontSize="14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" />
                            <TextBlock Text="※ 環境変数 DISCORD_BOT_TOKEN がある場合は自動読み込みされます。手動入力も可能です。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <Button Style="{StaticResource GlowButton}" Content="Save Token" Width="140" HorizontalAlignment="Left" Click="SaveToken_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══════════════════════════════════════════
                 4. ステータスフッター
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#50070B12" CornerRadius="0,0,18,18" BorderThickness="0,1,0,0" BorderBrush="#152030">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtStatus" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="|" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="10,0" />
                        <TextBlock Text="API: Discord v10" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="DISCORD LOOKUP CONSOLE → GUI" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
