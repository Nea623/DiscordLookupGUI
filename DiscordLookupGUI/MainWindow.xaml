<Window x:Class="DiscordLookup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="DISCORD LOOKUP GUI" 
        Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="gg sans, pack://application:,,,/Assets/Fonts/#gg sans, Segoe UI, Segoe UI Emoji, Yu Gothic UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ══════════════════════════════════════════
         Gaming RGB 用 独立アニメーション定義 (必要時のみ起動・省電力化)
         ══════════════════════════════════════════ -->
    <Window.Resources>
        <Storyboard x:Key="GamingRgbBorderStoryboard">
            <DoubleAnimation Storyboard.TargetName="RgbRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:4"
                             RepeatBehavior="Forever" />
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="RgbShadow"
                                          Storyboard.TargetProperty="Color"
                                          Duration="0:0:4"
                                          RepeatBehavior="Forever">
                <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="#FFFF0055" />
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFF7700" />
                <LinearColorKeyFrame KeyTime="0:0:1.3" Value="#FFFFDD00" />
                <LinearColorKeyFrame KeyTime="0:0:2.0" Value="#FF00FF66" />
                <LinearColorKeyFrame KeyTime="0:0:2.6" Value="#FF00DDFF" />
                <LinearColorKeyFrame KeyTime="0:0:3.3" Value="#FF0055FF" />
                <LinearColorKeyFrame KeyTime="0:0:4.0" Value="#FFFF0055" />
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="GamingRgbSearchIconStoryboard">
            <DoubleAnimation Storyboard.TargetName="SearchIconRgbRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:4"
                             RepeatBehavior="Forever" />
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="SearchIconRgbShadow"
                                          Storyboard.TargetProperty="Color"
                                          Duration="0:0:4"
                                          RepeatBehavior="Forever">
                <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="#FFFF0055" />
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFF7700" />
                <LinearColorKeyFrame KeyTime="0:0:1.3" Value="#FFFFDD00" />
                <LinearColorKeyFrame KeyTime="0:0:2.0" Value="#FF00FF66" />
                <LinearColorKeyFrame KeyTime="0:0:2.6" Value="#FF00DDFF" />
                <LinearColorKeyFrame KeyTime="0:0:3.3" Value="#FF0055FF" />
                <LinearColorKeyFrame KeyTime="0:0:4.0" Value="#FFFF0055" />
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <!-- ══════════════════════════════════════════
         起動時アニメーション (1.5秒スプラッシュ ➔ メイン画面展開)
         ══════════════════════════════════════════ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- ウィンドウ枠のポップイン -->
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.94" To="1.0"
                                     Duration="0:0:0.40">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.94" To="1.0"
                                     Duration="0:0:0.40">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- ① スプラッシュ画面: 1.5秒まで前面を完全キープ、1.5秒〜1.9秒でフェードアウト -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay"
                                                   Storyboard.TargetProperty="Opacity">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- スプラッシュ画面のロゴがゆっくり浮遊するスケール演出 (1.9秒かけてじっくり展開) -->
                    <DoubleAnimation Storyboard.TargetName="SplashContent"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.94" To="1.04"
                                     Duration="0:0:1.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashContent"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.94" To="1.04"
                                     Duration="0:0:1.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- ② メイン画面UI: 1.5秒まで完全不可視、1.5秒〜1.9秒でフワッとフェードイン展開 -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContentContainer"
                                                   Storyboard.TargetProperty="Opacity">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- メイン画面UIがわずかに下から所定位置に浮かび上がるスライド演出 -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContentContainer"
                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="10.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="10.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- ③ スプラッシュ終了時(1.9秒)に完全非表示(Collapsed)化 ＆ 背面入力解放 -->
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay"
                                                   Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0" Value="{x:Static Visibility.Visible}" />
                        <DiscreteObjectKeyFrame KeyTime="0:0:1.9" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>

                    <BooleanAnimationUsingKeyFrames Storyboard.TargetName="MainContentContainer"
                                                    Storyboard.TargetProperty="IsEnabled">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.0" Value="False" />
                        <DiscreteBooleanKeyFrame KeyTime="0:0:1.9" Value="True" />
                    </BooleanAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- 外枠とシャドウ (中央基準でスケールアニメーション適用、テーマ動的追従) -->
    <Border x:Name="RootBorder" Margin="12" CornerRadius="18" BorderThickness="1" 
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource WindowBgBrush}"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <Grid>
                <!-- ══════════════════════════════════════════
                     すりガラス背景画像レイヤー (軽量角丸クリップ ＆ BitmapCache)
                     ══════════════════════════════════════════ -->
                <Grid x:Name="ThemeBgLayer" ClipToBounds="True" SizeChanged="ThemeBgLayer_SizeChanged">
                    <Image x:Name="ThemeBgImage"
                           Source="{DynamicResource ThemeBackgroundImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           CacheMode="BitmapCache"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Source" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <BlurEffect Radius="24" RenderingBias="Quality" />
                        </Image.Effect>
                    </Image>
                    <!-- 半透明オーバーレイティント -->
                    <Border Background="{DynamicResource WindowOverlayBrush}" CornerRadius="17" />
                </Grid>

            <!-- ══════════════════════════════════════════
                 ウィンドウ枠線のキラリ星オーナメント (ユーザー考案 + 対称アクセント)
                 ══════════════════════════════════════════ -->
            <Canvas IsHitTestVisible="False" Visibility="{DynamicResource StarryDecorationVisibility}">
                <!-- 左枠線上: きらめく四芒星 (モックアップ通り) -->
                <Image Canvas.Left="-11" Canvas.Top="145" Source="Assets/StarryNight/star_sparkle_large.png"
                       Width="24" Height="24" Stretch="Uniform">
                    <Image.Effect>
                        <DropShadowEffect Color="#C4B5FD" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                    </Image.Effect>
                </Image>
                <!-- 右枠線上: 対になる控えめな星屑 (追加アクセント) -->
                <Image Canvas.Right="-9" Canvas.Top="320" Source="Assets/StarryNight/star_sparkle_large.png"
                       Width="18" Height="18" Stretch="Uniform" Opacity="0.8">
                    <Image.Effect>
                        <DropShadowEffect Color="#C4B5FD" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                    </Image.Effect>
                </Image>

                <!-- 🌟 ユーザー自由配置用: 画面全体のどこへでも置ける吊り下げ星 (Canvas.Left / Canvas.Top で自由移動) 🌟 -->
                <Image Canvas.Left="-3.5" Canvas.Top="0" Source="Assets/StarryNight/part_18_35x157.png"
                       Width="28" Height="110" Stretch="Uniform" Opacity="0.85">
                    <Image.Effect>
                        <DropShadowEffect Color="#C4B5FD" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                    </Image.Effect>
                </Image>
            </Canvas>
            <Grid x:Name="MainContentContainer" Opacity="0" IsEnabled="False" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform Y="10" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" /> <!-- タイトルバー -->
                    <RowDefinition Height="Auto" /> <!-- 検索 & トークン設定バー -->
                    <RowDefinition Height="*" /> <!-- メインコンテンツエリア -->
                    <RowDefinition Height="36" /> <!-- ステータスフッター -->
                </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 1. タイトルバー (ドラッグ移動可能)
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="18,18,0,0">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側: ブランドロゴ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentGlowMidBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" />
                        </Border>
                        <TextBlock Text="DISCORD" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" LOOKUP" FontWeight="Light" FontSize="16" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" GUI" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentGlowLowBrush}" CornerRadius="8" Padding="7,2">
                            <TextBlock Text="v2.4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 中央: ピルナビゲーションタブ (ウィンドウ全体の完全中央・左右均等配置) -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource TabContainerBgBrush}" CornerRadius="18" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource TabBorderBrush}">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Main" IsChecked="True" x:Name="TabMain" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Raw Data" x:Name="TabRaw" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Settings" x:Name="TabSettings" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                        </UniformGrid>
                    </Border>

                    <!-- タイトルバー左側装飾: ロゴとピルタブの間の星座アート (ユーザー考案) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                Margin="16,0,0,0" Visibility="{DynamicResource StarryDecorationVisibility}" IsHitTestVisible="False">
                        <Image Source="Assets/StarryNight/constellation_swan.png" Height="26" Stretch="Uniform" Opacity="0.85" VerticalAlignment="Center" />
                        <Image Source="Assets/StarryNight/star_sparkle_large.png" Height="14" Stretch="Uniform" Margin="6,-6,0,0" Opacity="0.85">
                            <Image.Effect>
                                <DropShadowEffect Color="#C4B5FD" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />
                            </Image.Effect>
                        </Image>
                    </StackPanel>

                    <!-- タイトルバー右側装飾: ピルタブと操作ボタンの間の流れ星 (ユーザー考案) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Margin="0,0,16,0" Visibility="{DynamicResource StarryDecorationVisibility}" IsHitTestVisible="False">
                        <Image Source="Assets/StarryNight/shooting_star.png" Width="72" Height="44" Stretch="Uniform" Opacity="0.95" VerticalAlignment="Center">
                            <Image.Effect>
                                <DropShadowEffect Color="#C4B5FD" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
                            </Image.Effect>
                        </Image>
                    </StackPanel>



                    <!-- 右側: ウィンドウ操作ボタン -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCircleButton}" x:Name="BtnThemeToggle" Content="🌙" Click="BtnThemeToggle_Click" Margin="0,0,8,0" ToolTip="テーマ選択">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource CyberContextMenu}">
                                    <MenuItem Header="☀️  Light Theme" Click="SelectThemeLight_Click" Style="{StaticResource CyberMenuItem}" />
                                    <MenuItem Header="🌙  Dark Theme" Click="SelectThemeDark_Click" Style="{StaticResource CyberMenuItem}" />
                                    <MenuItem Header="🌆  Sunset Theme" Click="SelectThemeSunset_Click" Style="{StaticResource CyberMenuItem}" />
                                    <MenuItem Header="🌠  Starry Night Theme" Click="SelectThemeStarryNight_Click" Style="{StaticResource CyberMenuItem}" />
                                    <MenuItem Header="🎮  Gaming RGB Theme" Click="SelectThemeGamingRgb_Click" Style="{StaticResource CyberMenuItem}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource WindowCircleButton}" Content="─" Click="MinimizeButton_Click" Margin="0,0,8,0" ToolTip="最小化" />
                        <Button Style="{StaticResource WindowCloseCircleButton}" Content="✕" Click="CloseButton_Click" ToolTip="閉じる" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 2. 検索バー & クイックアクション
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="20,4,20,12" Background="{DynamicResource SearchContainerBgBrush}" CornerRadius="12" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource SearchContainerBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ID入力欄 -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="UserIdInput" 
                                 Style="{StaticResource CyberTextBox}" 
                                 Text=""
                                 FontSize="15"
                                 KeyDown="UserIdInput_KeyDown"
                                 VerticalContentAlignment="Center"
                                 Padding="14,8,12,8" />
                        <TextBlock x:Name="UserIdPlaceholder" Text="Discord ユーザーID (Snowflake) を入力して Enter..." 
                                   Foreground="{DynamicResource InputPlaceholderBrush}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- 検索ボタン -->
                    <Button Grid.Column="1" x:Name="SearchButton" Style="{StaticResource GlowButton}" Content="LOOKUP USER" Click="SearchButton_Click" MinWidth="130" />
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 3. メインビュー (タブ切り替え)
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="20,0,20,10">
                
                <!-- 【タブ1: MAIN 画面 (プロフィール & 分析)】 -->
                <Grid x:Name="ViewMain" Visibility="Visible">

                    <!-- 未検索時のウェルカム・案内画面 (初期表示) -->
                    <Border x:Name="EmptyStateView" Visibility="Visible" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- アイコン発光サークル (Gaming RGB テーマ時は完全同期レインボーサイクル発光) -->
                            <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <!-- ① 通常テーマ用ベースサークル (Dark, Light, Sunset, StarryNight: 絵文字🔍の親しみやすい形のまま、各テーマカラーでグローなしでクッキリ染める) -->
                                <Border CornerRadius="36" Background="{DynamicResource AccentGlowLowBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="2">
                                    <Rectangle Width="32" Height="32" Fill="{DynamicResource SearchIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍" FontSize="30" FontFamily="Segoe UI Emoji" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Border>

                                <!-- ② 🎮 Gaming RGB テーマ専用オーバーレイ (Gaming RGB 選択時のみ前面に表示: 強烈レインボー回転ボーダー & 鮮烈緑ネオングロー) -->
                                <Grid Visibility="{DynamicResource GamingRgbVisibility}">
                                    <!-- 虫眼鏡がくっきり浮き出るスレートブラック円盤 + 3px太枠レインボー回転ボーダー & ネオングロー -->
                                    <Border CornerRadius="36" Background="#242832" BorderThickness="3">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <RotateTransform x:Name="SearchIconRgbRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#FFFF0055" Offset="0.0" />
                                                <GradientStop Color="#FFFF7700" Offset="0.16" />
                                                <GradientStop Color="#FFFFDD00" Offset="0.33" />
                                                <GradientStop Color="#FF00FF66" Offset="0.50" />
                                                <GradientStop Color="#FF00DDFF" Offset="0.66" />
                                                <GradientStop Color="#FF0055FF" Offset="0.83" />
                                                <GradientStop Color="#FFAA00FF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="SearchIconRgbShadow" BlurRadius="30" ShadowDepth="0" Color="#FF00FFCC" Opacity="1.0" />
                                        </Border.Effect>
                                    </Border>
                                    <!-- 虫眼鏡アイコン (Gaming RGB 専用: 鮮烈ネオングリーン固定発光) -->
                                    <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#00FF66" Opacity="0.9" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <TextBlock Text="AWAITING USER LOOKUP" FontWeight="ExtraBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="上部の入力欄に Discord ユーザーID (Snowflake) を入力し、Enterキーを押してください。" 
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <TextBlock Text="💡 ヒント: Discordでユーザーを右クリック ➔ 「ユーザーIDをコピー」で取得できます" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 検索結果表示グリッド (初期状態は非表示、検索完了時にスムーズフェードイン) -->
                    <Grid x:Name="SearchResultGrid" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SearchResultTranslate" Y="8" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── 左カード: User Profile ── -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- カードヘッダー -->
                                <Grid Grid.Row="0" Margin="16,14,16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentCyanBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="User Profile" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <!-- 追加アクセント: ヘッダー右端の星座ライン -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{DynamicResource StarryDecorationVisibility}" Opacity="0.75" IsHitTestVisible="False">
                                        <Image Source="Assets/StarryNight/constellation_small.png" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- プロフィール詳細 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,16">
                                    
                                    <!-- バナー & アバターのコンテナ -->
                                    <Grid Margin="0,0,0,16">
                                        <!-- バナー画像 (枠全体を満たし、完全中央配置 + 角丸クリップ) -->
                                        <Border x:Name="BannerContainer" Height="130" CornerRadius="12" Background="{DynamicResource BannerBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" SizeChanged="BannerContainer_SizeChanged">
                                            <Grid>
                                                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <!-- アバター画像 & デコレーション (真円クリップ + 発光シアン外枠 + デコレーションオーバーレイ) -->
                                        <Grid Width="96" Height="96" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,-34">
                                            <Ellipse x:Name="AvatarRing" Width="80" Height="80" Stroke="{DynamicResource AccentCyanBrush}" StrokeThickness="3" Fill="{DynamicResource CardInnerBgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect x:Name="AvatarShadow" Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.65" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <!-- アバター本体 (80x80) -->
                                            <Image x:Name="AvatarImage" Width="80" Height="80" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="40,40" RadiusX="38.5" RadiusY="38.5" />
                                                </Image.Clip>
                                            </Image>
                                            <!-- アバターデコレーション (96x96 / 高品質バイキュービック縮小) -->
                                            <Image x:Name="AvatarDecorationImage" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" />
                                        </Grid>
                                    </Grid>

                                    <!-- ユーザー名など & 惑星リング付き三日月 (ユーザー考案) -->
                                    <Grid Margin="0,12,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,18,0,0">
                                            <emoji:TextBlock x:Name="TxtGlobalName" Text="ユーザー未検索" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                                <!-- @username -->
                                                <emoji:TextBlock x:Name="TxtUsername" Text="@username" FontSize="13" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                                                <!-- BOT タグ -->
                                                <Border x:Name="BadgeBot" Margin="8,0,0,0" Background="#5865F2" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="BOT" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- クランタグ -->
                                                <Border x:Name="BadgeClan" Margin="8,0,0,0" Background="{DynamicResource AccentGlowLowBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image x:Name="ImgClanBadge" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        <emoji:TextBlock x:Name="TxtClanTag" Text="CLAN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 公式バッジ一覧 (@username ➔ [BOT] ➔ [CLAN] の右横にインライン配置) -->
                                                <Border x:Name="BorderBadgesContainer" Margin="8,0,0,0" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="6" Padding="4,2" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Visibility="Collapsed">
                                                    <StackPanel x:Name="BadgesPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- 🌟 ユーザー考案: バナー右下のリング付き三日月 ＋ きらめき星屑 🌟 -->
                                        <Grid Grid.Column="1" Margin="0,-16,10,0" VerticalAlignment="Center" Visibility="{DynamicResource StarryDecorationVisibility}" IsHitTestVisible="False">
                                            <Image Source="Assets/StarryNight/moon_with_ring.png" Width="96" Height="68" Stretch="Uniform">
                                                <Image.Effect>
                                                    <DropShadowEffect Color="#C4B5FD" BlurRadius="18" ShadowDepth="0" Opacity="0.9" />
                                                </Image.Effect>
                                            </Image>
                                            <!-- 追加アクセント: 月の横の小さなきらめき星 -->
                                            <Image Source="Assets/StarryNight/star_sparkle_large.png" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0">
                                                <Image.Effect>
                                                    <DropShadowEffect Color="#C4B5FD" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />
                                                </Image.Effect>
                                            </Image>
                                        </Grid>
                                    </Grid>

                                    <!-- 各種情報リスト -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserId" Text="-" IsReadOnly="True" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent Color" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent"
                                                        Cursor="Hand" ToolTip="クリックでカラーコードをコピー" MouseLeftButtonUp="AccentColor_Click">
                                                <Border x:Name="RectAccentColor" Width="14" Height="14" CornerRadius="3" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtAccentColor" Text="なし" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- アセットリンクボタン -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnOpenAvatar" Content="Open Avatar" Style="{StaticResource GlowButton}" FontSize="11" Padding="4,6" Click="BtnOpenAvatar_Click" IsEnabled="False" />
                                        <Button Grid.Column="2" x:Name="BtnOpenDecoration" Content="Open Deco" Style="{StaticResource GlowButton}" FontSize="11" Padding="4,6" Click="BtnOpenDecoration_Click" IsEnabled="False" />
                                        <Button Grid.Column="4" x:Name="BtnOpenBanner" Content="Open Banner" Style="{StaticResource GlowButton}" FontSize="11" Padding="4,6" Click="BtnOpenBanner_Click" IsEnabled="False" />
                                    </Grid>

                                    <!-- ── Discord 公式メンバーリスト原寸 ネームプレート (248x42px) & 詳細メタ情報 ── -->
                                    <TextBlock Text="Nameplate" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="2,12,0,4" HorizontalAlignment="Left" />
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左列: ネームプレート本体 (高さ42px) -->
                                        <Border Grid.Column="0" x:Name="NameplateCard" Width="248" Height="42" Margin="0,0,0,0" HorizontalAlignment="Left"
                                                CornerRadius="8" Background="#232035" BorderThickness="0">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,248,42" RadiusX="8" RadiusY="8" />
                                            </Border.Clip>
                                            <Grid>
                                                <!-- ネームプレート公式装飾 背景画像 (248x42 公式原寸・右端含む四隅角丸8pxクリップ) -->
                                                <Border Width="248" Height="42" CornerRadius="8">
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,248,42" RadiusX="8" RadiusY="8" />
                                                    </Border.Clip>
                                                    <Image x:Name="PlateBackgroundStaticImage" Width="248" Height="42" Opacity="0.6"
                                                           Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <!-- メインコンテンツ (アバター + 1行テキスト情報) -->
                                                <Grid Margin="5,0,6,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 1. 左側: アバター + デコレーション (直径32px真円クリップ + 38pxデコレーション) -->
                                                    <Grid Grid.Column="0" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- 円形アバター (直径32px / EllipseGeometryで真円クリップ) -->
                                                        <Image x:Name="PlateAvatarImage" Width="32" Height="32" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Clip>
                                                                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                                                            </Image.Clip>
                                                        </Image>

                                                        <!-- アバターデコレーション (幅38px, 高さ38px - 自前APNGエンジンで同期再生) -->
                                                        <Image x:Name="PlateAvatarDecoImage" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>

                                                    <!-- 2. 右側: ユーザー情報 (表示名 + クランバッジのみのシンプル1行構成) -->
                                                    <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 表示名 (Discord公式準拠 13px太字・絵文字対応・global_name反映) -->
                                                        <emoji:TextBlock Grid.Column="0" x:Name="PlateDisplayName" Text="User" FontSize="13" FontWeight="Bold" Foreground="#8EB4FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                        <!-- クランバッジ (角丸ピル: 🤍 ZETA) -->
                                                        <Border Grid.Column="1" x:Name="PlateClanContainer" Background="#2B2D31" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image x:Name="PlateClanBadgeImage" Width="11" Height="11" Margin="0,0,2,0" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                <TextBlock x:Name="PlateClanHeart" Text="🤍" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center" />
                                                                <emoji:TextBlock x:Name="PlateClanTag" Text="ZETA" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- 右列: ネームプレート詳細メタ情報 (ネームプレートと高さ42px・Y座標完全一致・クリックでコピー可能) -->
                                        <Border Grid.Column="1" Margin="8,0,0,0" Height="42" VerticalAlignment="Center"
                                                Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,4"
                                                Cursor="Hand" MouseLeftButtonUp="NameplateMetaCard_Click">
                                            <!-- ホバー時のリッチツールチップ -->
                                            <Border.ToolTip>
                                                <ToolTip Background="#18191C" BorderBrush="#383A40" BorderThickness="1" Padding="10,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Nameplate Collectibles" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                                            <TextBlock Text="💡 クリックでコピー" FontSize="9.5" Foreground="#949BA4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 1. sku_id -->
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="sku_id:" FontSize="10.5" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,8,3" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTipSkuId" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="#F2F3F5" Margin="0,0,0,3" />

                                                            <!-- 2. label -->
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="label:" FontSize="10.5" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,8,3" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtTipLabel" Text="--" FontSize="10.5" FontWeight="Bold" Foreground="#8EB4FF" Margin="0,0,0,3" />

                                                            <!-- 3. asset -->
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="asset:" FontSize="10.5" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,8,3" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtTipAsset" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="#F2F3F5" Margin="0,0,0,3" />

                                                            <!-- 4. palette -->
                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="palette:" FontSize="10.5" FontWeight="SemiBold" Foreground="#949BA4" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtTipPalette" Text="--" FontSize="10.5" Foreground="#F2F3F5" />
                                                        </Grid>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>

                                            <!-- 常時表示エリア (高さ42pxにピタッと収まる2段レイアウト) -->
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 上段: label (強調) + palette バッジ -->
                                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- label (個別クリックでlabelのみコピー可能・絵文字対応) -->
                                                    <emoji:TextBlock Grid.Column="0" x:Name="TxtPlateLabel" Text="--" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                     ToolTip="クリックで Label をコピー" MouseLeftButtonUp="CopyPlateLabel_Click" />

                                                    <!-- palette ピルバッジ (個別クリックでpaletteのみコピー可能) -->
                                                    <Border Grid.Column="1" Background="{DynamicResource TabContainerBgBrush}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                            ToolTip="クリックで Palette をコピー" MouseLeftButtonUp="CopyPlatePalette_Click">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border x:Name="PlatePaletteIndicator" Width="6" Height="6" CornerRadius="3" Background="Transparent" Margin="0,0,3,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                            <TextBlock x:Name="TxtPlatePalette" Text="--" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- 下段: sku_id ＋ asset (コンパクトに横並び・個別クリックでSKUコピー可能) -->
                                                <Grid Grid.Row="1" VerticalAlignment="Center" Background="Transparent"
                                                      ToolTip="クリックで SKU ID をコピー" MouseLeftButtonUp="CopyPlateSkuId_Click">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="SKU:" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" x:Name="TxtPlateSkuId" Text="--" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <!-- asset 内部バインディング -->
                                                    <TextBlock x:Name="TxtPlateAsset" Text="--" Visibility="Collapsed" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── 右カード: Timeline & Metrics ── -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- カードヘッダー -->
                            <Grid Grid.Row="0" Margin="16,14,16,10">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBlueBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Timeline &amp; Account Analytics" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <!-- 追加アクセント: ヘッダー右端の星座ライン -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{DynamicResource StarryDecorationVisibility}" Opacity="0.75" IsHitTestVisible="False">
                                    <Image Source="Assets/StarryNight/constellation_cassiopeia.png" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- メトリクス詳細 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,0,16,16">

                                    <!-- メトリクス行 1: アカウント作成日 (クリックでコピー可能) -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Account Creation Date" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock x:Name="TxtCreatedAtJst" Text="-- 年 -- 月 -- 日 --:--:--" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"
                                                       Cursor="Hand" ToolTip="クリックで作成日時 (JST) をコピー" MouseLeftButtonUp="CreatedAtJst_Click" />
                                            <TextBlock x:Name="TxtCreatedAtUtc" Text="UTC: --" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                                       Cursor="Hand" ToolTip="クリックで作成日時 (UTC) をコピー" MouseLeftButtonUp="CreatedAtUtc_Click" />
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 2: 経過年数 / 経過日数 (プログレスゲージ風デザイン) -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Account Age (経過時間)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                <Border HorizontalAlignment="Right" Background="{DynamicResource AccentGlowMidBrush}" CornerRadius="8" Padding="8,2">
                                                    <TextBlock x:Name="TxtElapsedBadge" Text="0.0 yrs" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- バーゲージ -->
                                            <Border Height="8" CornerRadius="4" Background="{DynamicResource CardInnerBgBrush}" Margin="0,12,0,8">
                                                <ProgressBar x:Name="ProgAccountAge" Value="0" Maximum="10" Height="8" Background="Transparent" Foreground="{DynamicResource AccentCyanBrush}" BorderThickness="0" />
                                            </Border>

                                            <Grid>
                                                <TextBlock Text="Day 0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="TxtElapsedDays" Text="0 日経過" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="10+ Years" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 3: Snowflake 解析情報 (すべてコピー & 個別コピー可能) -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Snowflake Decoding" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                <!-- Snowflake全項目一括コピーボタン -->
                                                <Border HorizontalAlignment="Right" Background="{DynamicResource AccentGlowLowBrush}" CornerRadius="6" Padding="6,2" Cursor="Hand"
                                                        ToolTip="Snowflake 解析情報をすべてコピー" MouseLeftButtonUp="CopySnowflakeAll_Click">
                                                    <TextBlock Text="📋 Copy All" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                                </Border>
                                            </Grid>
                                            
                                            <Grid Margin="0,0,0,4" Background="Transparent" Cursor="Hand" ToolTip="クリックで Epoch Offset をコピー" MouseLeftButtonUp="CopyEpoch_Click">
                                                <TextBlock Text="Epoch Offset" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="1420070400000 ms" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4" Background="Transparent" Cursor="Hand" ToolTip="クリックで Worker ID をコピー" MouseLeftButtonUp="CopyWorkerId_Click">
                                                <TextBlock Text="Internal Worker ID" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtWorkerId" Text="--" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid Background="Transparent" Cursor="Hand" ToolTip="クリックで Process ID をコピー" MouseLeftButtonUp="CopyProcessId_Click">
                                                <TextBlock Text="Internal Process ID" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtProcessId" Text="--" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>



                            <!-- 🌟 ユーザー考案: 右下の優美な三日月 ＋ 星ガーランド (追加アクセント) 🌟 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,16,14" Orientation="Horizontal"
                                        Visibility="{DynamicResource StarryDecorationVisibility}" IsHitTestVisible="False">
                                <!-- 吊り下げ星の可愛いオーナメント (追加アクセント) -->
                                <Image Source="Assets/StarryNight/hanging_star_mid.png" Height="44" Stretch="Uniform" Opacity="0.8" Margin="0,0,8,4" VerticalAlignment="Bottom" />
                                <!-- ユーザー考案の優美な三日月 -->
                                <Image Source="Assets/StarryNight/moon_crescent_large.png" Width="50" Height="50" Stretch="Uniform" Opacity="0.95" VerticalAlignment="Bottom">
                                    <Image.Effect>
                                        <DropShadowEffect Color="#C4B5FD" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
                                    </Image.Effect>
                                </Image>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid> <!-- SearchResultGrid 終了 -->
                </Grid> <!-- ViewMain 終了 -->

                <!-- 【タブ2: RAW DATA 画面】 -->
                <Grid x:Name="ViewRaw" Visibility="Collapsed">
                    <!-- 未検索時の案内画面 (初期表示・Mainと完全同期) -->
                    <Border x:Name="RawEmptyStateView" Visibility="Visible" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- アイコン発光サークル -->
                            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentGlowLowBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="2" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                                <TextBlock Text="{}{ }" FontSize="22" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="NO RAW DATA AVAILABLE" FontWeight="ExtraBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="ユーザーを検索すると、ここに Discord API の完全な生 JSON レスポンスが表示されます。" 
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <TextBlock Text="💡 API から返却されるすべての生データ（未公開・詳細フィールド含む）を確認できます" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 検索結果表示 (生 JSON ボックス・Mainと完全に同期して表示/非表示) -->
                    <Border x:Name="RawDataResultGrid" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5"
                            Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="16">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="RawDataTranslate" Y="8" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Raw Discord API Response (JSON)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="Copy JSON" Style="{StaticResource GlowButton}" FontSize="11" Padding="10,4" HorizontalAlignment="Right" Click="CopyRawJson_Click" />
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="TxtRawJson" IsReadOnly="True" Style="{StaticResource CyberTextBox}" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 【タブ3: SETTINGS 画面】 -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── 左カード: Bot Configuration ── -->
                    <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- カードヘッダー -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentCyanBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Bot Configuration" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <TextBlock Text="Discord Bot Token (カスタム設定)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8" />
                                <PasswordBox x:Name="InputBotToken" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentCyanBrush}" Padding="12,10" FontSize="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" />
                                
                                <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="✨ 共有Botトークン内蔵中！設定不要でそのまま検索可能です" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="💡 独自の Bot トークンを使用したい場合のみ、ここに入力して保存してください。空欄で保存またはクリアすると共有トークンに戻ります。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource GlowButton}" Content="Save Token" Width="130" HorizontalAlignment="Left" Click="SaveToken_Click" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource GlowButton}" Content="Reset to Shared" Width="140" HorizontalAlignment="Left" Click="ResetToken_Click" Opacity="0.85" />
                                </StackPanel>

                                <!-- テーマ設定 (ボタン押下でリスト表示) -->
                                <TextBlock Text="Theme Preference" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,22,0,8" />
                                <Button x:Name="BtnSettingsThemeSelect" Style="{StaticResource GlowButton}" Click="BtnSettingsThemeSelect_Click" HorizontalAlignment="Left" MinWidth="180">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsThemeCurrent" Text="🌙  Dark Theme" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" ▸" FontSize="12" Foreground="{DynamicResource AccentCyanBrush}" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource CyberContextMenu}">
                                            <MenuItem Header="☀️  Light Theme" Click="SelectThemeLight_Click" Style="{StaticResource CyberMenuItem}" />
                                            <MenuItem Header="🌙  Dark Theme" Click="SelectThemeDark_Click" Style="{StaticResource CyberMenuItem}" />
                                            <MenuItem Header="🌆  Sunset Theme" Click="SelectThemeSunset_Click" Style="{StaticResource CyberMenuItem}" />
                                            <MenuItem Header="🌠  Starry Night Theme" Click="SelectThemeStarryNight_Click" Style="{StaticResource CyberMenuItem}" />
                                            <MenuItem Header="🎮  Gaming RGB Theme" Click="SelectThemeGamingRgb_Click" Style="{StaticResource CyberMenuItem}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ── 右カード: About & Credits ── -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- カードヘッダー -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentPurpleBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="About &amp; Credits" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <!-- アプリ情報 -->
                                <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="DISCORD LOOKUP GUI" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border Margin="10,0,0,0" Background="{DynamicResource AccentGlowLowBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="v2.4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Cyberpunk-themed Discord User OSINT / Lookup Client" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12">
                                            <Run Text="Created by: " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="Neaneko" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            <Run Text="  •  Built with: " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="Visual Studio" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                            <Run Text=" &amp; " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="Antigravity IDE" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- リンクボタン -->
                                <Button Style="{StaticResource GlowButton}" Margin="0,0,0,14" Click="BtnOpenGitHub_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔗 " FontSize="13" />
                                        <TextBlock Text="GitHub Repository (Nea623/DiscordLookupGUI)" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- 技術スタック / 謝辞 -->
                                <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Special Thanks / Technologies" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="• Microsoft Visual Studio (C# / .NET Tooling)" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" Margin="0,2" />
                                        <TextBlock Text="• Antigravity IDE (Agentic AI Development Environment)" FontSize="11" Foreground="{DynamicResource AccentPurpleBrush}" FontWeight="SemiBold" Margin="0,2" />
                                        <TextBlock Text="• .NET 8 WPF (Windows Desktop)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Text="• XamlAnimatedGif (Animated GIF Engine)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Text="• Emoji.Wpf (DirectWrite Color Emoji Support)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                        <TextBlock Text="• Newtonsoft.Json (Discord API v10 Parser)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══════════════════════════════════════════
                 4. ステータスフッター
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{DynamicResource FooterBgBrush}" CornerRadius="0,0,18,18" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FooterBorderBrush}">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessGreenBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtStatus" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" />
                        <TextBlock Text="API: Discord v10" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="DISCORD LOOKUP GUI" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid> <!-- MainContentContainer 終了 -->

            <!-- ══════════════════════════════════════════
                 ゲーミング RGB ネオン発光ボーダー (前面レイヤー配置: フッターに遮られず全周囲が均一発光)
                 ══════════════════════════════════════════ -->
            <Border x:Name="GamingRgbBorder" CornerRadius="18" BorderThickness="2"
                    Visibility="{DynamicResource GamingRgbVisibility}" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush x:Name="RgbGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="RgbRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FFFF0055" Offset="0.0" />
                        <GradientStop Color="#FFFF7700" Offset="0.16" />
                        <GradientStop Color="#FFFFDD00" Offset="0.33" />
                        <GradientStop Color="#FF00FF66" Offset="0.50" />
                        <GradientStop Color="#FF00DDFF" Offset="0.66" />
                        <GradientStop Color="#FF0055FF" Offset="0.83" />
                        <GradientStop Color="#FFAA00FF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect x:Name="RgbShadow" BlurRadius="22" ShadowDepth="0" Color="#FF00FFCC" Opacity="0.85" />
                </Border.Effect>
            </Border>

            <!-- ══════════════════════════════════════════
                 起動時スプラッシュ画面 (1.5秒間前面を完全カバーし、背後の操作画面を一切隠す)
                 ══════════════════════════════════════════ -->
            <Grid x:Name="SplashOverlay">
                <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="17">
                    <Grid>
                        <!-- スプラッシュ中もタイトルバー部分を掴んでウィンドウ移動可能 -->
                        <Border Height="56" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                        <!-- 中央ロゴ & タイトル (浮遊スケールアニメーション適用) -->
                        <StackPanel x:Name="SplashContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                            </StackPanel.RenderTransform>

                            <!-- ネオン発光サークルロゴ -->
                            <Border Width="92" Height="92" CornerRadius="24" Background="{DynamicResource AccentGlowLowBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="35" ShadowDepth="0" Opacity="0.85" />
                                </Border.Effect>
                                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" />
                            </Border>

                            <!-- タイトル -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="DISCORD" FontWeight="ExtraBold" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text=" LOOKUP" FontWeight="Light" FontSize="30" Foreground="{DynamicResource AccentCyanBrush}" />
                                <TextBlock Text=" GUI" FontWeight="Bold" FontSize="30" Foreground="{DynamicResource AccentCyanBrush}" />
                            </StackPanel>

                            <!-- サブタイトル & ローディングプログレス演出 -->
                            <Border Margin="0,16,0,0" Background="{DynamicResource AccentGlowLowBrush}" CornerRadius="10" Padding="14,6" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="INITIALIZING CLIENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                    <TextBlock Text=" • v2.4" FontSize="11" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
