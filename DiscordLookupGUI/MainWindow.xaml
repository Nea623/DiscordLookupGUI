<Window x:Class="DiscordLookup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="Discord Lookup" 
        Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI, Segoe UI Emoji, Yu Gothic UI, Meiryo"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ══════════════════════════════════════════
         起動時アニメーション (1.5秒スプラッシュ ➔ メイン画面展開)
         ══════════════════════════════════════════ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- ウィンドウ枠のポップイン -->
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.94" To="1.0"
                                     Duration="0:0:0.40">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.94" To="1.0"
                                     Duration="0:0:0.40">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- ① スプラッシュ画面: 1.5秒まで前面を完全キープ、1.5秒〜1.9秒でフェードアウト -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay"
                                                   Storyboard.TargetProperty="Opacity">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- スプラッシュ画面のロゴがゆっくり浮遊するスケール演出 (1.9秒かけてじっくり展開) -->
                    <DoubleAnimation Storyboard.TargetName="SplashContent"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.94" To="1.04"
                                     Duration="0:0:1.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SplashContent"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.94" To="1.04"
                                     Duration="0:0:1.9">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- ② メイン画面UI: 1.5秒まで完全不可視、1.5秒〜1.9秒でフワッとフェードイン展開 -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContentContainer"
                                                   Storyboard.TargetProperty="Opacity">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="1.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- メイン画面UIがわずかに下から所定位置に浮かび上がるスライド演出 -->
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MainContentContainer"
                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="10.0" />
                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="10.0" />
                        <SplineDoubleKeyFrame KeyTime="0:0:1.9" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- ③ スプラッシュ終了時(1.9秒)に完全非表示(Collapsed)化 -->
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay"
                                                   Storyboard.TargetProperty="Visibility">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.0" Value="{x:Static Visibility.Visible}" />
                        <DiscreteObjectKeyFrame KeyTime="0:0:1.9" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- 外枠とシャドウ (中央基準でスケールアニメーション適用、テーマ動的追従) -->
    <Border x:Name="RootBorder" Margin="12" CornerRadius="18" BorderThickness="1" 
            BorderBrush="{DynamicResource CardBorderBrush}"
            Background="{DynamicResource WindowBgBrush}"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <!-- ══════════════════════════════════════════
                 メイン操作UIコンテナ (スプラッシュ演出中は完全非表示、1.5秒後にフェードイン)
                 ══════════════════════════════════════════ -->
            <Grid x:Name="MainContentContainer" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform Y="10" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" /> <!-- タイトルバー -->
                    <RowDefinition Height="Auto" /> <!-- 検索 & トークン設定バー -->
                    <RowDefinition Height="*" /> <!-- メインコンテンツエリア -->
                    <RowDefinition Height="36" /> <!-- ステータスフッター -->
                </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 1. タイトルバー (ドラッグ移動可能)
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="18,18,0,0">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側: ブランドロゴ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#204DF2D3" BorderBrush="#804DF2D3" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
                        </Border>
                        <TextBlock Text="DISCORD" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" LOOKUP" FontWeight="Light" FontSize="16" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" VerticalAlignment="Center" Background="#1A3B82F6" CornerRadius="8" Padding="7,2">
                            <TextBlock Text="v2.2" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 中央: ピルナビゲーションタブ (ウィンドウ全体の完全中央・左右均等配置) -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource TabContainerBgBrush}" CornerRadius="18" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource TabBorderBrush}">
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Main" IsChecked="True" x:Name="TabMain" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Raw Data" x:Name="TabRaw" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                            <RadioButton Style="{StaticResource PillTabButton}" Content="Settings" x:Name="TabSettings" Checked="Tab_Checked" MinWidth="92" Margin="2,0" />
                        </UniformGrid>
                    </Border>

                    <!-- 右側: ウィンドウ操作ボタン -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowCircleButton}" x:Name="BtnThemeToggle" Content="🌙" Click="BtnThemeToggle_Click" Margin="0,0,8,0" ToolTip="テーマ選択 (Light / Dark)">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource CyberContextMenu}">
                                    <MenuItem Header="☀️  Light Mode" Click="SelectThemeLight_Click" Style="{StaticResource CyberMenuItem}" />
                                    <MenuItem Header="🌙  Dark Mode" Click="SelectThemeDark_Click" Style="{StaticResource CyberMenuItem}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource WindowCircleButton}" Content="─" Click="MinimizeButton_Click" Margin="0,0,8,0" ToolTip="最小化" />
                        <Button Style="{StaticResource WindowCloseCircleButton}" Content="✕" Click="CloseButton_Click" ToolTip="閉じる" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 2. 検索バー & クイックアクション
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="20,4,20,12" Background="{DynamicResource SearchContainerBgBrush}" CornerRadius="12" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource SearchContainerBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ID入力欄 -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="UserIdInput" 
                                 Style="{StaticResource CyberTextBox}" 
                                 Text=""
                                 FontSize="15"
                                 KeyDown="UserIdInput_KeyDown"
                                 VerticalContentAlignment="Center"
                                 Padding="36,8,12,8" />
                        <TextBlock Text="🔍" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="UserIdPlaceholder" Text="Discord ユーザーID (Snowflake) を入力して Enter..." 
                                   Foreground="#556987" FontSize="13" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- 検索ボタン -->
                    <Button Grid.Column="1" x:Name="SearchButton" Style="{StaticResource GlowButton}" Content="LOOKUP USER" Click="SearchButton_Click" MinWidth="130" />
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 3. メインビュー (タブ切り替え)
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="20,0,20,10">
                
                <!-- 【タブ1: MAIN 画面 (プロフィール & 分析)】 -->
                <Grid x:Name="ViewMain" Visibility="Visible">

                    <!-- 未検索時のウェルカム・案内画面 (初期表示) -->
                    <Border x:Name="EmptyStateView" Visibility="Visible" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- アイコン発光サークル -->
                            <Border Width="72" Height="72" CornerRadius="36" Background="#154DF2D3" BorderBrush="#504DF2D3" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4DF2D3" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                                <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="AWAITING USER LOOKUP" FontWeight="ExtraBold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="上部の入力欄に Discord ユーザーID (Snowflake) を入力し、Enterキーを押してください。" 
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#203A6B9B">
                                <TextBlock Text="💡 ヒント: Discordでユーザーを右クリック ➔ 「ユーザーIDをコピー」で取得できます" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 検索結果表示グリッド (初期状態は非表示) -->
                    <Grid x:Name="SearchResultGrid" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- ── 左カード: User Profile ── -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- カードヘッダー -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,10">
                                    <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="User Profile" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <!-- プロフィール詳細 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,0,16,16">
                                    
                                    <!-- バナー & アバターのコンテナ -->
                                    <Grid Margin="0,0,0,16">
                                        <!-- バナー画像 (枠全体を満たし、完全中央配置 + 角丸クリップ) -->
                                        <Border x:Name="BannerContainer" Height="130" CornerRadius="12" Background="{DynamicResource BannerBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" SizeChanged="BannerContainer_SizeChanged">
                                            <Grid>
                                                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- アバター画像 (真円クリップ + 発光シアン外枠で絶対にはみ出さない設計) -->
                                        <Grid Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,-26">
                                            <Ellipse Width="80" Height="80" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="3" Fill="#0C1420">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#4DF2D3" BlurRadius="14" ShadowDepth="0" Opacity="0.65" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <Image x:Name="AvatarImage" Width="74" Height="74" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="37,37" RadiusX="37" RadiusY="37" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Grid>

                                    <!-- ユーザー名など (Emoji.Wpf によるフルカラー絵文字描画) -->
                                    <StackPanel Margin="0,30,0,12">
                                        <emoji:TextBlock x:Name="TxtGlobalName" Text="ユーザー未検索" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <emoji:TextBlock x:Name="TxtUsername" Text="@username" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                            <Border x:Name="BadgeClan" Margin="10,0,0,0" Background="#203B82F6" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image x:Name="ImgClanBadge" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <emoji:TextBlock x:Name="TxtClanTag" Text="CLAN" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 各種情報リスト -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserId" Text="-" IsReadOnly="True" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent Color" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border x:Name="RectAccentColor" Width="14" Height="14" CornerRadius="3" Background="Transparent" BorderBrush="#405575" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtAccentColor" Text="なし" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- アセットリンクボタン -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnOpenAvatar" Content="Open Avatar" Style="{StaticResource GlowButton}" FontSize="12" Padding="6,6" Click="BtnOpenAvatar_Click" IsEnabled="False" />
                                        <Button Grid.Column="2" x:Name="BtnOpenBanner" Content="Open Banner" Style="{StaticResource GlowButton}" FontSize="12" Padding="6,6" Click="BtnOpenBanner_Click" IsEnabled="False" />
                                    </Grid>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── 右カード: Timeline & Metrics ── -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- カードヘッダー -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,10">
                                <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Timeline &amp; Account Analytics" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- メトリクス詳細 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16,0,16,16">

                                    <!-- メトリクス行 1: アカウント作成日 -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Account Creation Date (JST)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock x:Name="TxtCreatedAtJst" Text="-- 年 -- 月 -- 日 --:--:--" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                            <TextBlock x:Name="TxtCreatedAtUtc" Text="UTC: --" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 2: 経過年数 / 経過日数 (プログレスゲージ風デザイン) -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Account Age (経過時間)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                <Border HorizontalAlignment="Right" Background="#204DF2D3" CornerRadius="8" Padding="8,2">
                                                    <TextBlock x:Name="TxtElapsedBadge" Text="0.0 yrs" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- バーゲージ -->
                                            <Border Height="8" CornerRadius="4" Background="#162235" Margin="0,12,0,8">
                                                <ProgressBar x:Name="ProgAccountAge" Value="0" Maximum="10" Height="8" Background="Transparent" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" />
                                            </Border>

                                            <Grid>
                                                <TextBlock Text="Day 0" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="TxtElapsedDays" Text="0 日経過" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="10+ Years" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- メトリクス行 3: Snowflake 解析情報 -->
                                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Snowflake Decoding" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                            
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Epoch Offset" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="1420070400000 ms" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Internal Worker ID" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtWorkerId" Text="--" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Internal Process ID" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock x:Name="TxtProcessId" Text="--" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </Grid> <!-- SearchResultGrid 終了 -->
                </Grid> <!-- ViewMain 終了 -->

                <!-- 【タブ2: RAW DATA 画面】 -->
                <Grid x:Name="ViewRaw" Visibility="Collapsed">
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Raw Discord API Response (JSON)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <TextBox Grid.Row="1" x:Name="TxtRawJson" IsReadOnly="True" Style="{StaticResource CyberTextBox}" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="/* API レスポンスがここに表示されます */" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 【タブ3: SETTINGS 画面】 -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── 左カード: Bot Configuration ── -->
                    <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="20">
                        <StackPanel>
                            <!-- カードヘッダー -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Bot Configuration" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="Discord Bot Token" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8" />
                            <PasswordBox x:Name="InputBotToken" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="12,10" FontSize="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,8" />
                            
                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <TextBlock Text="💡 環境変数 DISCORD_BOT_TOKEN が設定されている場合は自動的に読み込まれます。ここから手動でトークンを入力・上書きして保存することも可能です。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16" />
                            </Border>

                            <Button Style="{StaticResource GlowButton}" Content="Save Bot Token" Width="150" HorizontalAlignment="Left" Click="SaveToken_Click" />

                            <!-- テーマ設定 (ボタン押下でリスト表示) -->
                            <TextBlock Text="Theme Preference" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,22,0,8" />
                            <Button x:Name="BtnSettingsThemeSelect" Style="{StaticResource GlowButton}" Click="BtnSettingsThemeSelect_Click" HorizontalAlignment="Left" MinWidth="180">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSettingsThemeCurrent" Text="🌙  Dark Mode" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" ▸" FontSize="12" Foreground="{DynamicResource AccentCyanBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource CyberContextMenu}">
                                        <MenuItem Header="☀️  Light Mode" Click="SelectThemeLight_Click" Style="{StaticResource CyberMenuItem}" />
                                        <MenuItem Header="🌙  Dark Mode" Click="SelectThemeDark_Click" Style="{StaticResource CyberMenuItem}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ── 右カード: About & Credits ── -->
                    <Border Grid.Column="1" Margin="10,0,0,0" Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="20">
                        <StackPanel>
                            <!-- カードヘッダー -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentPurpleBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="About &amp; Credits" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- アプリ情報 -->
                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="DISCORD LOOKUP GUI" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Margin="10,0,0,0" Background="#204DF2D3" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="v2.2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Cyberpunk-themed Discord User OSINT / Lookup Client" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Created by: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Neaneko" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentCyanBrush}" />
                                        <TextBlock Text="  •  Built with: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Visual Studio" FontWeight="Bold" FontSize="12" Foreground="#C084FC" />
                                        <TextBlock Text=" &amp; " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="Antigravity IDE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentPurpleBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- リンクボタン -->
                            <Button Style="{StaticResource GlowButton}" Margin="0,0,0,14" Click="BtnOpenGitHub_Click" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔗 " FontSize="13" />
                                    <TextBlock Text="GitHub Repository (Nea623/DiscordLookupGUI)" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- 技術スタック / 謝辞 -->
                            <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="10" Padding="14,10" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="Special Thanks / Technologies" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="• Microsoft Visual Studio (C# / .NET Tooling)" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" Margin="0,2" />
                                    <TextBlock Text="• Antigravity IDE (Agentic AI Development Environment)" FontSize="11" Foreground="#A78BFA" FontWeight="SemiBold" Margin="0,2" />
                                    <TextBlock Text="• .NET 8 WPF (Windows Desktop)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Text="• XamlAnimatedGif (Animated GIF Engine)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Text="• Emoji.Wpf (DirectWrite Color Emoji Support)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Text="• Newtonsoft.Json (Discord API v10 Parser)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══════════════════════════════════════════
                 4. ステータスフッター
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{DynamicResource FooterBgBrush}" CornerRadius="0,0,18,18" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FooterBorderBrush}">
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessGreenBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TxtStatus" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="|" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" />
                        <TextBlock Text="API: Discord v10" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="DISCORD LOOKUP GUI" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid> <!-- MainContentContainer 終了 -->

            <!-- ══════════════════════════════════════════
                 起動時スプラッシュ画面 (1.5秒間前面を完全カバーし、背後の操作画面を一切隠す)
                 ══════════════════════════════════════════ -->
            <Grid x:Name="SplashOverlay">
                <Border Background="#FF080C14" CornerRadius="18">
                    <Grid>
                        <!-- スプラッシュ中もタイトルバー部分を掴んでウィンドウ移動可能 -->
                        <Border Height="56" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                        <!-- 中央ロゴ & タイトル (浮遊スケールアニメーション適用) -->
                        <StackPanel x:Name="SplashContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                            </StackPanel.RenderTransform>

                            <!-- ネオン発光サークルロゴ -->
                            <Border Width="92" Height="92" CornerRadius="24" Background="#184DF2D3" BorderBrush="#804DF2D3" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4DF2D3" BlurRadius="35" ShadowDepth="0" Opacity="0.85" />
                                </Border.Effect>
                                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
                            </Border>

                            <!-- タイトル -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="DISCORD" FontWeight="ExtraBold" FontSize="30" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text=" LOOKUP" FontWeight="Light" FontSize="30" Foreground="{StaticResource AccentCyanBrush}" />
                            </StackPanel>

                            <!-- サブタイトル & ローディングプログレス演出 -->
                            <Border Margin="0,16,0,0" Background="#153B82F6" CornerRadius="10" Padding="14,6" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#254DF2D3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="INITIALIZING CLIENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                    <TextBlock Text=" • v2.2" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
