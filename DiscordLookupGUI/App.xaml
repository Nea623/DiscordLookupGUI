<Application x:Class="DiscordLookup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ══════════════════════════════════════════
                 カラーパレット (サイバー/ネオ・ダークテーマ)
                 ══════════════════════════════════════════ -->
            <Color x:Key="WindowBgColor">#FF070B12</Color>
            <Color x:Key="HeaderBgColor">#CC0B111D</Color>
            <Color x:Key="CardBgColor">#CC0F192C</Color>
            <Color x:Key="CardInnerBgColor">#80080E18</Color>
            <Color x:Key="CardBorderColor">#333A6B9B</Color>
            <Color x:Key="AccentCyan">#FF4DF2D3</Color>
            <Color x:Key="AccentBlue">#FF3B82F6</Color>
            <Color x:Key="AccentPurple">#FF8B5CF6</Color>
            <Color x:Key="TextPrimary">#FFF1F5F9</Color>
            <Color x:Key="TextSecondary">#FF94A3B8</Color>
            <Color x:Key="TextMuted">#FF475569</Color>
            <Color x:Key="DangerRed">#FFF43F5E</Color>
            <Color x:Key="SuccessGreen">#FF10B981</Color>

            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
            <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
            <SolidColorBrush x:Key="CardInnerBgBrush" Color="{StaticResource CardInnerBgColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
            <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
            <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
            <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

            <!-- ピルタブボタンスタイル -->
            <Style x:Key="PillTabButton" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#154DF2D3" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#254DF2D3" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#664DF2D3" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF4DF2D3" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ネオン風ボタン -->
            <Style x:Key="GlowButton" TargetType="Button">
                <Setter Property="Background" Value="#204DF2D3" />
                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                <Setter Property="BorderBrush" Value="#804DF2D3" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#404DF2D3" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF4DF2D3" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ネオン風入力ボックス -->
            <Style x:Key="CyberTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CardInnerBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FF4DF2D3" BlurRadius="8" ShadowDepth="0" Opacity="0.4" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- タイトルバー丸ボタン -->
            <Style x:Key="WindowCircleButton" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="#15FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#30FFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 閉じるボタン専用 -->
            <Style x:Key="WindowCloseCircleButton" TargetType="Button" BasedOn="{StaticResource WindowCircleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
